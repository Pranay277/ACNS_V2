# Backend environment variables (backend/.env is gitignored — copy this
# file to .env and fill in real values).

# Application environment. Allowed: development / local / production.
# - development/local: dev conveniences (e.g. seed_users.py may run, local
#   CORS defaults apply).
# - production:        CORS_ALLOWED_ORIGINS becomes mandatory (fail-closed).
ENVIRONMENT=development

# CORS — comma-separated allow-list of browser origins that may call the API.
# Never use "*". In development/local this defaults to the local Vite origins
# (http://localhost:5173, http://127.0.0.1:5173) when unset. In production it
# MUST be set explicitly.
#   Example: CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=

# TextBee SMS gateway credentials (backend/.env is gitignored — copy this
# file to .env and fill in real values).
TEXTBEE_API_KEY=xxxxxxxxxxxxxxxx
TEXTBEE_DEVICE_ID=xxxxxxxxxxxxxxxx
TEXTBEE_BASE_URL=https://api.textbee.dev

# Frontend origin used to build the clickable issue link in SMS messages.
# Swap to the production origin when deploying (no trailing slash).
FRONTEND_BASE_URL=http://localhost:5173

# Rate limiting (P2-02) — in-memory per-IP limits. Each value is optional;
# the built-in defaults are safe for normal campus usage.
#   RATE_LIMIT_ENABLED=false would disable enforcement entirely (not recommended).
# RATE_LIMIT_LOGIN=20          # per 60s window
# RATE_LIMIT_SIGNUP=10         # per 3600s window
# RATE_LIMIT_CREATE_ISSUE=30   # per 3600s window
# RATE_LIMIT_CREATE_SUPERVISOR=20  # per 3600s window
# RATE_LIMIT_RESET_PASSWORD=10 # per 3600s window
# RATE_LIMIT_VERIFY_ISSUE=30   # per 60s window
# RATE_LIMIT_GAMIFICATION_AWARD=30  # per 60s window
# RATE_LIMIT_NAVIGATION_ROUTE=60    # per 60s window

# SMS abuse protection (P2-06) — persisted per-user / per-supervisor caps.
# Guards FAIL OPEN: a counter outage never blocks a report or SMS.
#   SMS_ABUSE_ENABLED=false disables the guards (not recommended).
# SMS_ABUSE_MAX_NEW_ISSUES_PER_USER_PER_DAY=10
# SMS_ABUSE_MAX_SMS_PER_SUPERVISOR_PER_DAY=30
# SMS_ABUSE_SMS_COOLDOWN_SECONDS=60

# Logging (P2-07). LOG_LEVEL controls verbosity; LOG_FORMAT=json emits one
# JSON line per record (structured logging). Phone numbers are always masked
# and SMS bodies / passwords / tokens are never logged.
# LOG_LEVEL=INFO
# LOG_FORMAT=text          # or json

# Fresh-auth window for sensitive admin actions (P2-03). The admin's Firebase
# session must be newer than this many seconds to deactivate / activate /
# change-email / reset-password / delete. Defaults to 300 (5 minutes).
# FRESH_AUTH_MAX_AGE_SECONDS=300

# Seed script (scripts/seed_users.py) — REQUIRED, development only.
# Shared password for all seeded dev accounts. The script aborts if unset,
# refuses to run unless ENVIRONMENT is development/local, and never prints
# the password.
SEED_ACCOUNT_PASSWORD=

# Optional development admin account seeded by scripts/seed_users.py.
# Leave empty to skip. Credentials live here — never in application logic.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_NAME=Pranay
